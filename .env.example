# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="FullStack Dev Portfolio"

# Neon PostgreSQL Database Connection String
# Example: postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.us-east-2.aws.neon.tech/portfolio_db?sslmode=require
DATABASE_URL="postgresql://user:password@host/portfolio_db?sslmode=require"

# Contact form email receiver
CONTACT_EMAIL=contact.developer@example.com

# JWT / NextAuth secret for admin dashboard
JWT_SECRET="generate-a-secure-random-32-char-secret"
